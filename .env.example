# Local development only. Use secret management and a least-privilege DB role in production.
POSTGRES_PASSWORD=memory-local-only
MEMORY_APP_PASSWORD=memory-app-local-only
MEMORY_POSTGRES_PORT=55432
MEMORY_DATABASE_URL=postgresql+psycopg://memory_app:memory-app-local-only@127.0.0.1:55432/memory
MEMORY_MIGRATION_DATABASE_URL=postgresql+psycopg://memory:memory-local-only@127.0.0.1:55432/memory
MEMORY_CREDENTIALS_FILE=config/credentials.json
# hash-test is a deterministic test double, not a semantic model.
MEMORY_EMBEDDING_BACKEND=compatible
MEMORY_EMBEDDING_MODEL=nomic-embed-text:v1.5
MEMORY_EMBEDDING_VERSION=nomic-v1.5-search-prefixes-v1
MEMORY_EMBEDDING_DIMENSIONS=768
MEMORY_EMBEDDING_DOCUMENT_PREFIX="search_document: "
MEMORY_EMBEDDING_QUERY_PREFIX="search_query: "
MEMORY_PROVIDER_BASE_URL=http://localhost:11434/v1
MEMORY_PROVIDER_API_KEY=local
# Optional independent embedding API. Leave blank to share the LLM endpoint.
# A separate endpoint never inherits the LLM API key; set its own key if needed.
MEMORY_EMBEDDING_PROVIDER_BASE_URL=
MEMORY_EMBEDDING_PROVIDER_API_KEY=
# Set nvidia for APIs requiring distinct input_type=query/passage.
MEMORY_EMBEDDING_INPUT_TYPE_MODE=prefix
# Disable optional reasoning output when requesting validated JSON.
MEMORY_PROVIDER_ENABLE_THINKING=false
MEMORY_EXTRACTION_MODEL=nemotron-3-ultra:cloud
# Use prompt_json for Ollama cloud models; output is still validated locally.
MEMORY_EXTRACTION_RESPONSE_FORMAT=prompt_json
MEMORY_REQUEST_TIMEOUT_SECONDS=180
MEMORY_REFLECTION_BACKEND=compatible
MEMORY_REFLECTION_MODEL=nemotron-3-ultra:cloud
MEMORY_CRITIC_MODEL=nemotron-3-ultra:cloud
MEMORY_REASONING_EFFORT=none
MEMORY_GENERAL_DISCOVERY_ENABLED=true
MEMORY_REFLECTION_MAX_MODEL_CANDIDATES=1
MEMORY_REDIS_URL=redis://127.0.0.1:6379/0
MEMORY_REFLECTION_INTERVAL_SECONDS=600
MEMORY_SERENDIPITY_INTERVAL_SECONDS=3600
MEMORY_DAILY_INTERVAL_SECONDS=86400
MEMORY_DREAMER_INTERVAL_SECONDS=604800
MEMORY_CANDIDATE_RETENTION_DAYS=30
MEMORY_ROLLING_MESSAGES=10
MEMORY_EXTRACTION_THRESHOLD=0.55

# Optional isolated execution pilot; default assistant behavior is unchanged.
MEMORY_HERMES_ENABLED=false
MEMORY_HERMES_ALLOWED_AGENTS=[]
# Set actual isolated-runtime paths before opting in (see docs/hermes-integration.md).
# MEMORY_HERMES_PYTHON=C:/absolute/project/.hermes-runtime/venv/Scripts/python.exe
# MEMORY_HERMES_SOURCE=C:/absolute/project/.hermes-runtime/source/hermes-agent-1f6efd6eb0ba6b573c73c96d14dff1be4454823d
MEMORY_HERMES_WORKSPACE=.hermes-runtime/workspace
MEMORY_HERMES_TIMEOUT_SECONDS=120
MEMORY_HERMES_MAX_ITERATIONS=6
MEMORY_ASSISTANT_PROMPT_TOKENS=32768
MEMORY_ASSISTANT_OUTPUT_TOKENS=2000
MEMORY_ASSISTANT_TEMPLATE_RESERVE_TOKENS=512

# Optional approved task supervisor. Apply prepared migration 0019 first.
MEMORY_AUTONOMY_ENABLED=false
MEMORY_AUTONOMY_ALLOWED_AGENTS=[]
MEMORY_AUTONOMY_INTERVAL_SECONDS=30
MEMORY_AUTONOMY_BATCH_SIZE=20
MEMORY_AUTONOMY_DAILY_TOOL_CALLS=100
MEMORY_AUTONOMY_DAILY_MODEL_CALLS=50
MEMORY_CONTRASTIVE_DISCOVERY_ENABLED=true
