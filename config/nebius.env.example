# Copy to an ignored private .env.nebius; do not overwrite the existing .env.cloud.
# Discover the exact NVIDIA model ID with python -m scripts.nebius_preflight.
MEMORY_PROVIDER_BASE_URL=https://api.tokenfactory.nebius.com/v1
MEMORY_PROVIDER_API_KEY=replace-privately
MEMORY_EXTRACTION_MODEL=REPLACE_WITH_DISCOVERED_NVIDIA_MODEL_ID
MEMORY_REFLECTION_MODEL=REPLACE_WITH_DISCOVERED_NVIDIA_MODEL_ID
MEMORY_CRITIC_MODEL=REPLACE_WITH_DISCOVERED_NVIDIA_MODEL_ID
MEMORY_EXTRACTION_RESPONSE_FORMAT=prompt_json
# No provider-specific chat_template_kwargs unless tested against the chosen model.
MEMORY_PROVIDER_ENABLE_THINKING=null
MEMORY_REQUEST_TIMEOUT_SECONDS=180
# Clear a prior model-specific tokenizer unless replaced with a matching one.
MEMORY_CONTEXT_TOKENIZER_FILE=
MEMORY_HANDOFF_ENABLED=true
MEMORY_CLOUD_DISCLOSURE_ENABLED=true
MEMORY_LOCAL_PROVIDER_URLS=[]
# Explicit independent embedding configuration is necessary. Changing the model
# requires separate projections/reindex; do not point existing vectors at another model.
# MEMORY_EMBEDDING_PROVIDER_BASE_URL=...
# MEMORY_EMBEDDING_PROVIDER_API_KEY=...
